direction: down

request: {
  label: "Run request"
  shape: hexagon
}

team_planner: {
  label: "Team planner\nplan proposals\nand task reforms"
  shape: rectangle
  width: 160
  height: 110
}

scheduler: {
  label: "Local scheduler\nclaim leases and state transitions"
  shape: rectangle
}

task_files: {
  label: "Markdown task files\nauthoritative task state"
  shape: stored_data
}

board: {
  label: "board.md\ngenerated human view"
  shape: document
}

capabilities: {
  label: "Fixed capability registry\nprofiles, skills, tools, context budget"
  shape: document
}

worker_pool: {
  label: "Elastic short-lived workers\nclaim compatible ready tasks\nwrite compact outputs, then exit"
  shape: cloud
}

artifacts: {
  label: "Immutable artifact store\nsources, evidence, claims, reports"
  shape: stored_data
}

review_tasks: {
  label: "Blocked-task planner review\nre-form one failed task"
  shape: rectangle
}

recovery: {
  label: "Recovery\nlease expires: reassign once\nsecond failure: blocked planner review"
  shape: rectangle
}

revision: {
  label: "Targeted revision\nconflict verdict stales only dependents"
  shape: rectangle
}

request -> team_planner: opens run
team_planner -> scheduler: proposes plan or reform
scheduler -> task_files: single-writer updates
task_files -> board: renders status
task_files -> worker_pool: ready task envelope
capabilities -> worker_pool: selects profile
worker_pool -> scheduler: claim or completion proposal
scheduler -> artifacts: accepted immutable output
scheduler -> review_tasks: blocked task or invalid completion
review_tasks -> team_planner: reform request
scheduler -> recovery: expired lease
recovery -> scheduler: reassign or block
artifacts -> revision: new contradictory evidence
revision -> task_files: conflict and revision tasks
revision -> artifacts: preserve provenance
