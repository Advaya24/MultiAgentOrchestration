direction: down

request: {
  label: "Research request"
  shape: hexagon
}

lead: {
  label: "Team lead"
  shape: rectangle
}

plan_task: {
  label: "T-001 plan_research\ncontext: request and scope"
  shape: document
}

discover: {
  label: "T-002 discover_sources\ncollect source records"
  shape: document
}

extract: {
  label: "T-003 extract_evidence\ncontext: source artifact IDs"
  shape: document
}

assess: {
  label: "T-004 assess_claims\ncontext: evidence artifact IDs"
  shape: document
}

conflict: {
  label: "T-005 resolve_conflict\ncontext: assessed claim IDs"
  shape: document
}

write_brief: {
  label: "T-006 write_brief\ncontext: conflict-verdict artifact ID"
  shape: document
}

brief: {
  label: "Research brief artifact\nrendered as report.md"
  shape: document
}

candidate_sources: {
  label: "Candidate-source artifacts"
  shape: stored_data
}

evidence: {
  label: "Evidence artifacts\nexcerpt, date, definition, provenance"
  shape: stored_data
}

claims: {
  label: "Assessed-claim artifacts"
  shape: stored_data
}

failure: {
  label: "Lease expires\nreassign once"
  shape: rectangle
}

blocked: {
  label: "lead_review\nsecond failure blocks task"
  shape: document
}

request -> lead
lead -> plan_task
plan_task -> discover
discover -> candidate_sources
candidate_sources -> extract
extract -> evidence
evidence -> assess
assess -> claims
claims -> conflict
conflict -> write_brief
write_brief -> brief

discover -> failure: worker dies {style.stroke-dash: 3}
failure -> discover: one reassignment {style.stroke-dash: 3}
failure -> blocked: second failure {style.stroke-dash: 3}
blocked -> lead
