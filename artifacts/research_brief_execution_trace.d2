direction: down

request: {
  label: "Research request"
  shape: hexagon
}

lead: {
  label: "Team lead"
  shape: person
}

plan_task: {
  label: "T-001 plan_research\ncontext: request and scope"
  shape: document
}

discover_a: {
  label: "T-002 discover_sources\nsearch angle A"
  shape: document
}

discover_b: {
  label: "T-003 discover_sources\nsearch angle B"
  shape: document
}

extract: {
  label: "T-004 extract_evidence\ncontext: retrieved source IDs"
  shape: document
}

assess: {
  label: "T-005 assess_claim\ncontext: evidence IDs only"
  shape: document
}

review: {
  label: "T-006 review_evidence\nindependent high-risk review"
  shape: document
}

draft: {
  label: "T-007 draft_brief\ncontext: accepted claim IDs"
  shape: document
}

brief: {
  label: "Accepted cited brief"
  shape: document
}

candidate_sources: {
  label: "Candidate-source artifacts"
  shape: stored_data
}

evidence: {
  label: "Evidence artifacts\nexcerpt, date, definition, provenance"
  shape: stored_data
}

claims: {
  label: "Accepted claim artifacts"
  shape: stored_data
}

late_evidence: {
  label: "Late contradictory\nevidence artifact"
  shape: stored_data
}

conflict: {
  label: "T-008 resolve_conflict\npreserve both records"
  shape: document
}

revision: {
  label: "T-009 revise_artifact\nonly affected claim and draft"
  shape: document
}

failure: {
  label: "Lease expires\nreassign once"
  shape: rectangle
}

blocked: {
  label: "T-010 lead_review\nsecond failure blocks task"
  shape: document
}

request -> lead
lead -> plan_task
plan_task -> discover_a
plan_task -> discover_b
discover_a -> candidate_sources
discover_b -> candidate_sources
candidate_sources -> extract
extract -> evidence
evidence -> assess
assess -> review
review -> claims
claims -> draft
draft -> brief

discover_a -> failure: worker dies {style.stroke-dash: 3}
failure -> discover_a: one reassignment {style.stroke-dash: 3}
failure -> blocked: second failure {style.stroke-dash: 3}
blocked -> lead

late_evidence -> conflict: opens review {style.stroke-dash: 3}
claims -> conflict: affected claim reference {style.stroke-dash: 3}
conflict -> revision: stale dependency only {style.stroke-dash: 3}
revision -> claims: superseding claim {style.stroke-dash: 3}
revision -> draft: revise brief {style.stroke-dash: 3}
